{
  "name": "@gitmog/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Git Mog CLI: one command for full bounded deterministic public-GitHub analysis.",
  "bin": {
    "gitmog": "./bin/gitmog.mjs",
    "git-mog": "./bin/gitmog.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/clean-build-output.mjs dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@gitmog/battle": "workspace:*",
    "@gitmog/github": "workspace:*",
    "@gitmog/personality": "workspace:*",
    "@gitmog/quality-judge": "workspace:*",
    "@gitmog/scoring": "workspace:*",
    "@gitmog/source-analysis": "workspace:*"
  },
  "devDependencies": {
    "@gitmog/config": "workspace:*",
    "@gitmog/test-fixtures": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
