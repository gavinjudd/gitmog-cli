{
  "name": "gitmog",
  "version": "0.4.0",
  "type": "module",
  "description": "Deterministic public-GitHub battles with optional aggregate Private Context.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gavinjudd/gitmog-cli.git"
  },
  "engines": {
    "node": "^22.23.2 || >=24.16.0 <25 || ^26.7.0"
  },
  "bin": {
    "gitmog": "./bin/gitmog.mjs",
    "git-mog": "./bin/gitmog.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node build.mjs && vitest run"
  }
}
