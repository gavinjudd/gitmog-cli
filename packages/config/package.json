{
  "name": "@gitmog/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript, ESLint and Vitest presets. The single home for repository configuration.",
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./package.json": "./package.json",
    "./typescript/base.json": "./typescript/base.json",
    "./typescript/node-lib.json": "./typescript/node-lib.json",
    "./vitest/no-network": "./vitest/no-network.ts",
    "./vitest/node": "./vitest/node.ts"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "typescript": ">=6.0.0 <6.1.0",
    "vitest": ">=4"
  }
}
