{
  "name": "@gitmog/github",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bounded public GitHub collection, deterministic selection, rate limits and opt-in redacted source sampling.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@gitmog/analyzers": "workspace:*"
  },
  "devDependencies": {
    "@gitmog/config": "workspace:*",
    "@gitmog/test-fixtures": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
