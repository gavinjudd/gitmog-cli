{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gavinjudd/gitmog-cli/calibration/schema/training-manifest.schema.json",
  "title": "Quality Judge public training manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "state",
    "reason",
    "repositories",
    "pairs",
    "judgmentsCollected"
  ],
  "properties": {
    "$schema": { "const": "./schema/training-manifest.schema.json" },
    "schemaVersion": { "const": "1.0.0-blinded-pairwise" },
    "state": { "enum": ["not-collected", "training-ready"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
    "repositories": { "type": "array", "maxItems": 150 },
    "pairs": { "type": "array", "maxItems": 1000 },
    "judgmentsCollected": { "type": "integer", "minimum": 0 }
  }
}
