{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gavinjudd/gitmog-cli/calibration/schema/batch.schema.json",
  "title": "Quality Judge blinded review batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "calibrationVersion", "batchId", "pairs"],
  "properties": {
    "schemaVersion": { "const": "1.0.0-blinded-pairwise" },
    "calibrationVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "batchId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/pair" }
    }
  },
  "$defs": {
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairId", "languageCohort", "sides"],
      "properties": {
        "pairId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
        "languageCohort": { "enum": ["typescript", "javascript", "python", "go"] },
        "sides": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/side" }
        }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "repository", "commitSha", "files"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleLabel", "path", "role", "language"],
      "properties": {
        "sampleLabel": { "type": "string", "pattern": "^sample-[1-7]$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "role": { "enum": ["implementation", "test"] },
        "language": { "enum": ["typescript", "javascript", "python", "go"] }
      }
    }
  }
}
